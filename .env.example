# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# ---------------------------------------------------------------------------

# --- LLM provider chain (cloud only): primary first, then ordered fallbacks ---
# providers: gemini | ollama_cloud | openrouter | openai_compatible
# OpenRouter is the FIRST fallback (structured-output-capable free model); Ollama Cloud is last
# (its OpenAI endpoint is unreliable for structured output). max_retries=0 → immediate failover.
PRIMARY_PROVIDER=gemini
FALLBACK_PROVIDERS=openrouter,ollama_cloud

# --- Gemini (primary) — https://aistudio.google.com/apikey ---
# NB: free tier is ~20 requests/day. Model lineup rotates (gemini-2.5-flash was retired).
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- OpenRouter (first fallback) — https://openrouter.ai/keys ---
# Pick a *currently* free model that supports structured outputs (lineup rotates):
# https://openrouter.ai/models?max_price=0  — free tiers also throttle ~per-minute.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Ollama Cloud (last-resort fallback) — https://ollama.com/settings/keys ---
# Uses the OpenAI-compatible endpoint. Browse cloud models: https://ollama.com/search?c=cloud
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b

# --- Generic OpenAI-compatible (optional; only if used in the chain) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- Search ---
TAVILY_API_KEY=

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
# In production use auth + TLS: rediss://:PASSWORD@host:6379/0  (keep Redis internal-only)
REDIS_STATE_TTL_SECONDS=86400
REDIS_LOCK_TTL_SECONDS=600

# --- Budgets (hard caps, enforced in code; retries/fallbacks consume these; resume never resets) ---
MAX_SUB_QUESTIONS=5
MAX_SEARCHES_PER_SUB_QUESTION=3
MAX_TOTAL_TOKENS=100000
WALL_CLOCK_SECONDS=300
REVIEWER_SEND_BACKS=1
MAX_TOTAL_SEARCHES=15
MAX_TOTAL_FETCHES=40
MAX_GRAPH_TRANSITIONS=60
MAX_FINDINGS_TOTAL=60
MAX_CITATIONS=60

# --- Secure web fetch / SSRF defense ---
# Leave ALLOW_PRIVATE_NETWORKS=false in production (true only for local dev against localhost).
ALLOW_PRIVATE_NETWORKS=false
MAX_REDIRECTS=3
MAX_RESPONSE_BYTES=3000000
FETCH_TOTAL_TIMEOUT=25

# --- API security ---
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development            # set to "production" to harden defaults (docs off, strict checks)
ENABLE_DOCS=true                   # auto-disabled when ENVIRONMENT=production
TRUSTED_HOSTS=*                    # set an explicit host allowlist in production
CORS_ALLOW_ORIGINS=               # comma-separated allowlist; empty = no cross-origin
API_MAX_BODY_BYTES=16384
